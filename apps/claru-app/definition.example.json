{
  "identifier": "claru",
  "displayName": "Claru AI",
  "bundleIdentifier": "ai.claru.app",
  "afterRecording": "discard",
  "states": [
    { "id": "home", "present": [{ "name": "REPLACE_WITH_HOME_SCREEN" }] },
    { "id": "task-ready", "present": [{ "name": "REPLACE_WITH_TASK_READY_SCREEN" }] },
    { "id": "recording", "present": [{ "name": "REPLACE_WITH_RECORDING_SCREEN" }] },
    { "id": "review", "present": [{ "name": "REPLACE_WITH_REVIEW_SCREEN" }] }
  ],
  "actions": [
    {
      "id": "open-assigned-task",
      "from": ["home"],
      "tap": { "name": "REPLACE_WITH_TASK_IDENTIFIER" },
      "to": "task-ready",
      "impact": "navigation"
    },
    {
      "id": "close-task",
      "from": ["task-ready"],
      "tap": { "name": "REPLACE_WITH_CLOSE_CONTROL" },
      "to": "home",
      "impact": "navigation"
    },
    {
      "id": "start-recording",
      "from": ["task-ready"],
      "tap": { "name": "REPLACE_WITH_START_CONTROL" },
      "to": "recording",
      "impact": "startsRecording"
    },
    {
      "id": "stop-recording",
      "from": ["recording"],
      "tap": { "name": "REPLACE_WITH_STOP_CONTROL" },
      "to": "review",
      "impact": "stopsRecording"
    },
    {
      "id": "save-recording",
      "from": ["review"],
      "tap": { "name": "REPLACE_WITH_SAVE_CONTROL" },
      "to": "task-ready",
      "impact": "submitsRecording"
    },
    {
      "id": "discard-recording",
      "from": ["review"],
      "tap": { "name": "REPLACE_WITH_DISCARD_CONTROL" },
      "to": "task-ready",
      "impact": "deletesRecording"
    }
  ],
  "appTransitions": [
    { "from": "recording", "to": "review" }
  ],
  "goals": {
    "running": ["recording"],
    "paused": ["task-ready"]
  }
}
